# Copy this file to .env and fill in DATABASE_URL / DIRECT_URL with your
# Neon connection strings (Neon dashboard -> Connection Details):
#   DATABASE_URL = the "pooled connection" string (host has -pooler)
#   DIRECT_URL   = the "direct connection" string (same host without -pooler)
# Prisma migrations use DIRECT_URL; the app uses DATABASE_URL at runtime.
# pgbouncer=true is required on the pooled URL so Prisma disables prepared
# statement caching (avoids "cached plan must not change result type").
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET=changeme
DEVICE_API_KEY=changeme-device-key
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
