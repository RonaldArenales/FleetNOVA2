generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
  DRIVER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum MaintenanceStatus {
  SCHEDULED
  DONE
  OVERDUE
  CANCELLED
}

enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

// Patron de ids: cada tabla es un entero autoincremental que arranca en un
// bloque propio de 6 digitos (ver migracion 20260901_short_ids), asi con
// solo mirar el numero se sabe de que tabla es sin tener que consultarlo:
//   Driver 100000+  User 200000+  Vehicle 300000+  VehicleDriver 400000+
//   MaintenanceSchedule 500000+  MaintenanceRecord 600000+  FuelLog 700000+
//   Alert 800000+  GpsReading 900000+  ObdReading 1000000+
//   AccessRequest 1100000+
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Cuenta de acceso (rol DRIVER) vinculada a esta ficha de conductor.
  driverId     Int?     @unique
  driver       Driver?  @relation("DriverAccount", fields: [driverId], references: [id])

  // Flota que este OPERATOR creo/posee (ver vehicleScope.ts). Los vehiculos
  // de un ADMIN cuentan como suyos, pero ADMIN de todas formas ve todo.
  ownedVehicles    Vehicle[] @relation("VehicleOwner")
  // Conductores que este OPERATOR registro (mismo alcance que ownedVehicles).
  ownedDrivers     Driver[]  @relation("DriverOwner")

  // Solo aplica a rol VIEWER: el operador cuya flota puede observar.
  // null = no ve ningun vehiculo hasta que un ADMIN lo asocie.
  viewScopeOwnerId Int?
  viewScopeOwner   User?  @relation("ViewScope", fields: [viewScopeOwnerId], references: [id])
  viewers          User[] @relation("ViewScope")
}

model Vehicle {
  id                   Int      @id @default(autoincrement())
  plate                String   @unique
  brand                String
  model                String
  year                 Int
  vin                  String?
  status               VehicleStatus @default(ACTIVE)
  odometerKm           Float    @default(0)
  tireInstalledKm      Float    @default(0)
  tireLifeKm           Float    @default(80000)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Operador (o admin) que registro el vehiculo; define que OPERATOR/VIEWER
  // puede verlo (ver backend/src/utils/vehicleScope.ts).
  ownerId              Int
  owner                User     @relation("VehicleOwner", fields: [ownerId], references: [id])

  drivers              VehicleDriver[]
  gpsReadings          GpsReading[]
  obdReadings          ObdReading[]
  fuelLogs             FuelLog[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords   MaintenanceRecord[]
  alerts               Alert[]

  @@index([ownerId])
}

model Driver {
  id            Int      @id @default(autoincrement())
  name          String
  documentId    String   @unique
  licenseNumber String
  phone         String?
  createdAt     DateTime @default(now())

  // Operador (o admin) que registro al conductor; mismo alcance que
  // Vehicle.ownerId (ver backend/src/utils/vehicleScope.ts).
  ownerId       Int
  owner         User     @relation("DriverOwner", fields: [ownerId], references: [id])

  vehicles      VehicleDriver[]
  account       User?    @relation("DriverAccount")

  @@index([ownerId])
}

model VehicleDriver {
  id         Int      @id @default(autoincrement())
  vehicleId  Int
  driverId   Int
  assignedAt DateTime @default(now())
  active     Boolean  @default(true)

  vehicle    Vehicle @relation(fields: [vehicleId], references: [id])
  driver     Driver  @relation(fields: [driverId], references: [id])

  @@index([vehicleId])
  @@index([driverId])
}

model GpsReading {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  lat       Float
  lng       Float
  speedKph  Float
  timestamp DateTime @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, timestamp])
}

model ObdReading {
  id             Int      @id @default(autoincrement())
  vehicleId      Int
  rpm            Int
  engineTempC    Float
  batteryVoltage Float
  transmissionOk Boolean  @default(true)
  engineOn       Boolean
  odometerKm     Float
  faultCodes     String[]
  timestamp      DateTime @default(now())

  vehicle        Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, timestamp])
}

model FuelLog {
  id             Int      @id @default(autoincrement())
  vehicleId      Int
  litersAdded    Float
  cost           Float?
  odometerAtFill Float
  timestamp      DateTime @default(now())

  vehicle        Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, timestamp])
}

model MaintenanceSchedule {
  id            Int      @id @default(autoincrement())
  vehicleId     Int
  type          String
  dueDate       DateTime?
  dueOdometerKm Float?
  description   String?
  status        MaintenanceStatus @default(SCHEDULED)
  createdAt     DateTime @default(now())

  vehicle       Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model MaintenanceRecord {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  type        String
  description String?
  cost        Float?
  odometerKm  Float
  performedAt DateTime @default(now())

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

model Alert {
  id        Int        @id @default(autoincrement())
  vehicleId Int
  level     AlertLevel @default(INFO)
  message   String
  read      Boolean    @default(false)
  createdAt DateTime   @default(now())

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
}

// Solicitudes de acceso enviadas desde el formulario publico de la pagina
// principal (sin autenticacion). El panel admin las revisa y las marca
// como atendidas.
model AccessRequest {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String
  reviewed  Boolean  @default(false)
  createdAt DateTime @default(now())
}
